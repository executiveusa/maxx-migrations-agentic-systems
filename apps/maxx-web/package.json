{
  "name": "maxx-web",
  "private": true,
  "version": "0.1.0",
  "description": "Maxx Migrations marketing site, migration audit intake, and CRM/migration-engine dashboard MVP.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "harness:preflight": "node scripts/harness/preflight.mjs",
    "harness:no-stubs": "node scripts/harness/no-stubs.mjs",
    "harness:routes": "node scripts/harness/route-audit.mjs",
    "harness:links": "node scripts/harness/link-check.mjs",
    "harness:api": "node scripts/harness/api-crud.mjs",
    "harness:copy": "node scripts/harness/copy-audit.mjs",
    "harness:env": "node scripts/harness/env-audit.mjs",
    "harness:artifacts": "node scripts/harness/artifact-audit.mjs",
    "harness:browser": "node scripts/harness/browser-verify.mjs",
    "harness:all": "node scripts/harness/run-all.mjs",
    "verify:full": "npm run lint && npm run typecheck && npm run test && npm run build && npm run harness:all"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
