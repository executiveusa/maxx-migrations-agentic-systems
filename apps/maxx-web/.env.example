# Copy this file to .env.local and fill in the values you have.
# Every variable is optional in local/seed mode — features that depend on a
# missing variable show "setup required" instead of failing or faking success.

# --- Auth / seed mode -------------------------------------------------------
# Set to "true" once real auth is wired up. Leave unset locally to keep the
# demo organization + seed data banner active across the app shell.
NEXT_PUBLIC_AUTH_CONFIGURED=false

# Set to "false" to disable local mock providers for social/telephony and
# force real provider errors instead. Defaults to enabled.
MOCK_INTEGRATIONS=true

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# uuid of the maxx_organizations row prod-mode API routes scope queries to.
# Stand-in for real per-session org resolution until Phase 2 (auth) lands.
NEXT_PUBLIC_DEMO_ORG_ID=

# --- MAXX Stage 00 / Client Zero ---------------------------------------------
# Server-side public intake is fixed to this seeded ICM tenant. Do not accept
# arbitrary tenant IDs from the browser.
MAXX_INTAKE_TENANT_SLUG=macs-digital-media

# --- MAXX federation machine surface -----------------------------------------
# Shared only between trusted server-side MAXX services/clients. Never expose
# this value to browser code or ICM artifacts. Use a unique 32+ byte secret in
# deployed environments.
MAXX_MIGRATIONS_API_KEY=
# Base URL used by CLI/MCP clients. Example: https://migrations.example.com
MAXX_MIGRATIONS_URL=http://127.0.0.1:3000

# --- Anthropic (Agent Chat) --------------------------------------------------
ANTHROPIC_API_KEY=

# --- Twilio (Missed Call Text Back) ------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Meta (Social Media Planner) ---------------------------------------------
META_ACCESS_TOKEN=
META_PAGE_ID=
META_APP_ID=
META_APP_SECRET=

# --- Postiz (optional alternative social scheduling backend) ----------------
POSTIZ_API_KEY=
POSTIZ_BASE_URL=

# --- GoHighLevel (GHL Import Wizard live API mode) ---------------------------
GHL_API_KEY=
GHL_LOCATION_ID=

# --- Migration engine ---------------------------------------------------------
# Set to any non-empty value to route new migration jobs through the
# server-side live crawl adapter instead of the deterministic seed plan.
MIGRATION_CRAWLER_ENABLED=

# --- Flywheel VPS (multi-agency project launcher) ---------------------------
# See docs/deployment/FLYWHEEL_VPS_SETUP.md. Both required for the Project
# Launcher to actually start an agent session instead of reporting
# "setup_required".
FLYWHEEL_VPS_URL=
FLYWHEEL_VPS_SECRET=

# --- MACS Restaurant Revenue Proof (Bunna pilot; completely disabled by default) ---
# Requires NEXT_PUBLIC_AUTH_CONFIGURED=true and verified maxx_organization_members
# for operator access. API keys are server-only and scoped to exactly one org.
MAXX_RESTAURANT_CLIENT_ORG_ID=
MAXX_RESTAURANT_AGENT_KEY=
# MCP/other agents must authenticate through server-side credentials only.
MACS_RESTAURANT_API_URL=
# Square: ONLY read permissions. Never configure live credentials without
# restaurant owner consent. Start with sandbox; production requires explicit
# reviewed deployment change and confirmed Square merchant/location identity.
MAXX_RESTAURANT_SQUARE_ACCESS_TOKEN=
MAXX_RESTAURANT_SQUARE_LOCATION_ID=
MAXX_RESTAURANT_SQUARE_ORG_ID=
MAXX_RESTAURANT_SQUARE_ENV=
# Toast, Clover, and Owner.com are not connected by this first slice.
